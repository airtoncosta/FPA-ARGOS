# FPA ARGOS — .gitignore

# PDFs (Portarias, DOU, etc.)
*.pdf

# Arquivos de dados brutos e dumps grandes (>100MB)
*.zip
*.ZIP
*.csv
*.CSV

# Dados de município extraídos
*.txt

# Artefatos temporários
git_status.txt
COMMIT_EDITMSG

# Imagens grandes em Base64 (geradas)
code_sandbox_light_git_fe61910d_1781185357/js/scaar_logo.js

# Script de correção manual (contém credenciais)
code_sandbox_light_git_fe61910d_1781185357/fix.html

# Node modules
node_modules/

# Ambiente
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build temporário do SIGTAP
.temp_sigtap/

# Sincronização CNES: arquivos brutos, snapshots e CNS gerados em runtime
data/cnes/
code_sandbox_light_git_fe61910d_1781185357/cnes_data/auto/
__pycache__/
*.pyc
.venv/

# GitHub Actions workflows (requer permissão workflow separada)
.github/

# Plugins instalados localmente
.agents/plugins/
